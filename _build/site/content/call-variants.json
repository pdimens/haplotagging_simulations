,{"type":"text","value":" assembly.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BBfpmEcbnG"}],"key":"EP4Byi9f89"}],"key":"MFi7coeJ6q"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/linked_reads/${size}/depths\"\n    OUTDIR=\"simulated_data/alignments/${size}/\"\n    harpy align bwa --skip-reports -t 22 -o $OUTDIR -g dmel_genome/dmel_2_3.fa $DIR\ndone","key":"wi9VNtZJW8"},{"type":"output","id":"8AulVbv6PuhNDeJUqr6Wi","data":[],"key":"ZMvL7DebGt"}],"key":"tQHiR9Oe4M"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calling SNPs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Bhp8wZWHk5"}],"identifier":"calling-snps","label":"Calling SNPs","html_id":"calling-snps","implicit":true,"key":"qFHKO0gAJB"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"After aligning, we need to call SNPs. This needs to be done per size class and per depth, since the Harpy snp calling process calls for all samples supplied at once and the output is a single BCF file of the SNPs for all the supplied samples.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Pfhqn9YXqH"}],"key":"Dru54IZVu5"}],"key":"A3nsdZoFGE"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\ndepths=(\"05X\" \"2X\" \"5X\" \"10X\" \"20X\")\n\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/alignments/${size}/\"\n    for depth in \"${depths[@]}\"; do\n        OUTDIR=\"simulated_data/called_snps/${size}/${depth}\"\n        harpy snp mpileup --skip-reports -r 1000000 -t 20 -o ${OUTDIR} -g dmel_genome/dmel_2_3.fa ${DIR}/sample_*.${depth}.bam\n    done\ndone","key":"ZaWIINP7sW"},{"type":"output","id":"DAnXU4yEOL9HCkZbcN5FU","data":[],"key":"ySC92p6oAY"}],"key":"zh6Qx3GoD3"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calling Structural Variants (inversions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rG3iHAxZnH"}],"identifier":"calling-structural-variants-inversions","label":"Calling Structural Variants (inversions)","html_id":"calling-structural-variants-inversions","implicit":true,"key":"gj8d0OkOz1"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"There will be two approaches to calling the inversions: ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"GbNtyETtAz"},{"type":"inlineCode","value":"LEVIATHAN","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MjMxUc89sE"},{"type":"text","value":" and ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OctQw5hspg"},{"type":"inlineCode","value":"NAIBR","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"LxltR0Sd5x"},{"type":"text","value":". Both are being used because their performance can vary greatly and we are trying to maximize finding the inversions we simulated. In addition to the two callers, we will be trying to call inversions per-sample ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Lkq58U9s0E"},{"type":"emphasis","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ex0GAeaI9V"}],"key":"jn1IcGQb3K"},{"type":"text","value":" per-population. The latter is a means of pooling samples together from biologically meaningful groups (e.g. genetic populations) and calling inversions in that “mega sample”. This is an approach we are trying to leverage specifically for low-depth samples, since pooling samples together will boost the depth.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xggQRN9TRL"}],"key":"jOqXkFhf6O"}],"key":"moAryWqOUE"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Leviathan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hg0uIekM9H"}],"identifier":"leviathan","label":"Leviathan","html_id":"leviathan","implicit":true,"key":"ZQI0MWuWyC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Starting with Leviathan because it doesn’t require phasing, meaning it’s overally simpler to run.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MsHtN1GsMT"}],"key":"SFmOlenzOD"}],"key":"yHkyJxuSxr"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\ndepths=(\"05X\" \"2X\" \"5X\" \"10X\" \"20X\")\n\nfor size in \"${sizes[@]}\"; do\n  harpy popgroup -o simulated_data/alignments/${size}/${size}.groups simulated_data/alignments/${size}\n  for depth in \"${depths[@]}\"; do\n    grep \".$depth\" simulated_data/alignments/${size}/${size}.groups > simulated_data/alignments/${size}/${size}.${depth}.group\n    harpy sv leviathan -t 20 -b 1 -r 95,95,95 -o simulated_data/called_sv/leviathan/${size}/${depth}/by_sample -g dmel_genome/dmel_2_3.fa simulated_data/alignments/${size}/*${depth}.bam\n    harpy sv leviathan -t 20 -b 1 -r 95,95,95 -o simulated_data/called_sv/leviathan/${size}/${depth}/by_pop -g dmel_genome/dmel_2_3.fa -p simulated_data/alignments/${size}/${size}.${depth}.group simulated_data/alignments/${size}/*${depth}.bam\n    done\ndone\n","key":"ypVJrxef6D"},{"type":"output","id":"4cQoz_X_iWrQzozAVSNgH","data":[],"key":"bRBblrqvnm"}],"key":"eV44Nl5Xju"}],"key":"LTZQPzCD2O"},"references":{"cite":{"order":[],"data":{}}}}