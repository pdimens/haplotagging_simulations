:{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\nmkdir -p simulated_data/linked_reads\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/inversions_snps/${size}\"\n    for i in $(seq -w 1 1 10); do\n        SAMPLE=\"sample_${i}\"\n        OUTDIR=\"simulated_data/linked_reads/${size}/${SAMPLE}\"\n        echo \"harpy simulate linkedreads --quiet -o ${OUTDIR} -m 10 -r 0 -p 1000 -n 20 ${DIR}/${SAMPLE}.snp_inv.hap1.fasta.gz ${DIR}/${SAMPLE}.snp_inv.hap2.fasta.gz\" >> simulated_data/linked_reads/sim_reads.sh\n    done\ndone\n#parallel --progress -j 16 :::: simulated_data/linked_reads/sim_reads.sh","key":"n8rKeMsGSW"},{"type":"output","id":"IROR-6YWlO_ck1M3oJF_O","data":[],"key":"PFrF3OaitI"}],"key":"CikdkKy6h2"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Once again, to minimize the disk footprint, we will combine the forward reads of ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nphaoYMcGz"},{"type":"inlineCode","value":"hap0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vCtrz8xJ4n"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A4vESG2QWH"},{"type":"inlineCode","value":"hap1","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iTryakRcdL"},{"type":"text","value":", same with reverse, then delete all the intermediate files harpy created.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Y0i6Xmpj7d"}],"key":"V8ozzC5zvz"}],"key":"y5b5mVJuiF"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\nfor size in \"${sizes[@]}\"; do\n    OUTDIR=\"simulated_data/linked_reads/${size}/raw\"\n    mkdir -p ${OUTDIR}\n    for i in $(seq -w 1 1 10); do\n        SAMPLE=\"sample_${i}\"\n        DIR=\"simulated_data/linked_reads/${size}/${SAMPLE}\"\n        cat ${DIR}/sim_hap0.R1.fq.gz ${DIR}/sim_hap1.R1.fq.gz > ${OUTDIR}/${SAMPLE}.R1.fq.gz\n        cat ${DIR}/sim_hap0.R2.fq.gz ${DIR}/sim_hap1.R2.fq.gz > ${OUTDIR}/${SAMPLE}.R2.fq.gz\n        rm -r ${DIR}\n    done\ndone","key":"YQjvJqWBc1"},{"type":"output","id":"hfqahd_82knedAD7DRLAJ","data":[],"key":"lgZpVHvFyO"}],"key":"K0rAvY8CjV"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Depth (Downsampling) treatments","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ngDUk3c8Vu"}],"identifier":"create-depth-downsampling-treatments","label":"Create Depth (Downsampling) treatments","html_id":"create-depth-downsampling-treatments","implicit":true,"key":"czsPFauGMK"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Now that the reads are created, we need to downsample them to specific depths:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"VlWs4IPYO1"}],"key":"pv4RJKXtbh"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"0.5X","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IDtHa5Gt6M"}],"key":"GU8uNmqCZ8"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"2X","position":{"start":