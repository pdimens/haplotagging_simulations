{"line":4,"column":1}},"key":"sxRecqFwAH"}],"key":"PRNkEkNewt"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"total paired-end length: ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cVtllb0nik"},{"type":"inlineCode","value":"225bp","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"BaHhpd97Y3"}],"key":"PclAKyLY6G"}],"key":"OVlZU6VLf5"}],"key":"DEOkFcLyO7"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/linked_reads/${size}/raw\"\n    OUTDIR=\"simulated_data/linked_reads/${size}/qc\"\n    harpy qc --quiet -a auto -m 75 -t 10 -o $OUTDIR -x \"--max_len2 150\" $DIR\ndone","key":"DGgoIiylbo"},{"type":"output","id":"YptRypiWFB---xhUfaH9N","data":[],"key":"HdZ86qxEep"}],"key":"ovJU8LkC9L"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Depth Downsampling","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xON3vcllbZ"}],"identifier":"depth-downsampling","label":"Depth Downsampling","html_id":"depth-downsampling","implicit":true,"key":"DTjtSJX9Z9"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We need a random seed set identically for all samples and depth-treatments so that each “sample” of lower treatment is effectively a subsample of the treatment immediately above it (i.e. 2X is a subset of 5X, which is a subset of 10X, etc.). This means we are testing for “less of the same data” rather than a completely random set of reads for each depth-treatment. A way of accomplishing this is some basic math:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"lq39qzisLj"}],"key":"OHEkaWSNcI"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"there are ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fEqZzB6XTz"},{"type":"inlineCode","value":"108,990,206","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"d7nyWfdPBJ"},{"type":"text","value":" bp in 4-chrom Dmel assembly used to simulate the data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TnlTjmKvbd"}],"key":"ofmYvdecGP"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"484,401","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"IwaHkXnZrE"},{"type":"text","value":" PE reads @ ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"h17htxsOH8"},{"type":"inlineCode","value":"225","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"IFhhThcr7t"},{"type":"text","value":" bp (total) makes 1X","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hfe4t8n56z"}],"key":"SnyBDFpAhA"}],"key":"SAi3zU0a5a"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"So we can just use simple arithmetic to know exactly how many reads we need","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"qwzmeMy5PN"}],"key":"dwRkyzzoOG"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Each sample should have its own random seed so we aren’t inadvertantly choosing the same reads across samples. The linked-read simulation has a randomness element when sampling sequences, but it’s better to play it safe here too.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Itj72oN9eI"}],"key":"GkypptL60D"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"This is once again parallelized because doing it serially is prohibitively slow","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"CPHhIvo1cB"}],"key":"rORU5wGeTN"}],"key":"XwiKILAwPI"},{"type":"block","kind":"notebook-code","data":{},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nfrom concurrent.futures import ThreadPoolExecutor\n\n# 108,990,206 bp in 4-chrom Dmel assembly\n# 484,401 PE reads @ 225bp (total) makes 1X\n\ndepths = {\n    \"05X\": 484401 // 2,\n    \"2X\": 484401 * 2,\n    \"5X\": 484401* 5,\n    \"10X\": 484401 * 10,\n    \"20X\": 484401 * 20\n}\n\nwith ThreadPoolExecutor(max_workers=20) as executor:\n    for size in [\"small\", \"medium\", \"large\", \"xl\"]:\n        os.makedirs(f\"simulated_data/linked_reads/{size}/depths\", exist_ok = True)\n        DIR = f\"simulated_data/linked_reads/{size}/qc\"\n        OUTDIR = f\"simulated_data/linked_reads/{size}/depths\"\n        for num in range(1,11):\n            SAMPLE=f\"sample_{num:02}\"\n            SEED=num\n            for depth,val in depths.items():\n                executor.submit(os.system, f\"seqtk sample -s{SEED} {DIR}/{SAMPLE}.R1.fq.gz {val} | gzip > {OUTDIR}/{SAMPLE}.{depth}.R1.fq.gz\")\n                executor.submit(os.system, f\"seqtk sample -s{SEED} {DIR}/{SAMPLE}.R2.fq.gz {val} | gzip > {OUTDIR}/{SAMPLE}.{depth}.R2.fq.gz\")","key":"U9CrbM0tYj"},{"type":"output","id":"BbFZ3C2sLLC89L4h1IME2","data":[],"key":"ZdkdMXw30Z"}],"key":"gRwCklPtGP"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Aligning sequences","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dO93fbYidw"}],"identifier":"aligning-sequences","label":"Aligning sequences","html_id":"aligning-sequences","implicit":true,"key":"Tugb6h5Rea"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"With the simulated data ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OTZcBFG4Jx"},{"type":"emphasis","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"finally","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kqxeEqABPS"}],"key":"Ag33XM2kXx"},{"type":"text","value":" ready and QC’d, we can now align them onto the original (unmodified) 4-chromosome ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WzIdrPx8gS"},{"type":"emphasis","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"D. melanogaster","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tVPZpwEtad"}],"key":"xGvnNRVmlc"},{"type":"text","value":" assembly.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"h9kEfOxGJ3"}],"key":"ftCEZrGEzH"}],"key":"N4aoz2NJp4"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/linked_reads/${size}/depths\"\n    OUTDIR=\"simulated_data/alignments/${size}/\"\n    harpy align bwa --skip-reports -t 22 -o $OUTDIR -g dmel_genome/dmel_2_3.fa $DIR\ndone","key":"Vsg44qu2iv"},{"type":"output","id":"39_9BSxjGACMDr4eR3foB","data":[],"key":"xxvLJYzfAo"}],"key":"IOSXHiRgJO"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calling SNPs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gFd8to47KE"}],"identifier":"calling-snps","label":"Calling SNPs","html_id":"calling-snps","implicit":true,"key":"PcxI5qqdML"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"After aligning, we need to call SNPs. This needs to be done per size class and per depth, since the Harpy snp calling process calls for all samples supplied at once and the output is a single BCF file of the SNPs for all the supplied samples.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ck4guO6BKd"}],"key":"G1hqEMv46R"}],"key":"KAySv2pvhD"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\ndepths=(\"05X\" \"2X\" \"5X\" \"10X\" \"20X\")\n\nfor size in \"${sizes[@]}\"; do\n    DIR=\"simulated_data/alignments/${size}/\"\n    for depth in \"${depths[@]}\"; do\n        OUTDIR=\"simulated_data/called_snps/${size}/${depth}\"\n        harpy snp mpileup --skip-reports -r 1000000 -t 20 -o ${OUTDIR} -g dmel_genome/dmel_2_3.fa ${DIR}/sample_*.${depth}.bam\n    done\ndone","key":"iWqvTvOQD2"},{"type":"output","id":"lTw2aDYHcEWkl9LVe3sBp","data":[],"key":"WBqverDqet"}],"key":"sM6PJ3AIXk"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calling Structural Variants (inversions)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Edht2408rX"}],"identifier":"calling-structural-variants-inversions","label":"Calling Structural Variants (inversions)","html_id":"calling-structural-variants-inversions","implicit":true,"key":"SkvbdLJsYa"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"There will be two approaches to calling the inversions: ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nJtgQXPFrW"},{"type":"inlineCode","value":"LEVIATHAN","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"TrEEHATCaT"},{"type":"text","value":" and ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ExESMDOLSV"},{"type":"inlineCode","value":"NAIBR","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"sHCwsqwbn5"},{"type":"text","value":". Both are being used because their performance can vary greatly and we are trying to maximize finding the inversions we simulated. In addition to the two callers, we will be trying to call inversions per-sample ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"U3H1O462qY"},{"type":"emphasis","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"and","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rmq6z9MDM5"}],"key":"LTJ6PcuKss"},{"type":"text","value":" per-population. The latter is a means of pooling samples together from biologically meaningful groups (e.g. genetic populations) and calling inversions in that “mega sample”. This is an approach we are trying to leverage specifically for low-depth samples, since pooling samples together will boost the depth.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"O2XnGUQi8F"}],"key":"z57G3IAMTP"}],"key":"p8b14O01LI"},{"type":"block","kind":"notebook-content","data":{},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Leviathan","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oaKrOTRsXl"}],"identifier":"leviathan","label":"Leviathan","html_id":"leviathan","implicit":true,"key":"NQmiVhsDtI"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Starting with Leviathan because it doesn’t require phasing, meaning it’s overally simpler to run.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UIBwbR0hdw"}],"key":"IxZAoJiNXG"}],"key":"dNaM5L6yWB"},{"type":"block","kind":"notebook-code","data":{"vscode":{"languageId":"shellscript"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%%bash\nsizes=(\"small\" \"medium\" \"large\" \"xl\")\ndepths=(\"05X\" \"2X\" \"5X\" \"10X\" \"20X\")\n\nfor size in \"${sizes[@]}\"; do\n  harpy popgroup -o simulated_data/alignments/${size}/${size}.groups simulated_data/alignments/${size}\n  for depth in \"${depths[@]}\"; do\n    grep \".$depth\" simulated_data/alignments/${size}/${size}.groups > simulated_data/alignments/${size}/${size}.${depth}.group\n    harpy sv leviathan -t 20 -b 1 -r 95,95,95 -o simulated_data/called_sv/leviathan/${size}/${depth}/by_sample -g dmel_genome/dmel_2_3.fa simulated_data/alignments/${size}/*${depth}.bam\n    harpy sv leviathan -t 20 -b 1 -r 95,95,95 -o simulated_data/called_sv/leviathan/${size}/${depth}/by_pop -g dmel_genome/dmel_2_3.fa -p simulated_data/alignments/${size}/${size}.${depth}.group simulated_data/alignments/${size}/*${depth}.bam\n    done\ndone\n","key":"SFZha6zbi3"},{"type":"output","id":"zQ7cDuI3kxnw7fZvWw1Jq","data":[],"key":"uWA163sVOT"}],"key":"baKRj4QLVL"}],"key":"BvPRiMkMam"},"references":{"cite":{"order":[],"data":{}}}}